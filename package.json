  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "//test:customer:e2e": "Opt-in real run. PowerShell: $env:RUN_CUSTOMER_E2E=1; npm run test:customer:e2e | bash: RUN_CUSTOMER_E2E=1 npm run test:customer:e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:lender": "playwright test --project=chromium --project=mobile",
    "test:customer": "playwright test --project=customer-chromium --project=customer-mobile",
    "test:customer:e2e": "playwright test --project=customer-e2e",
    "report": "playwright show-report reports/html-report"
  },
